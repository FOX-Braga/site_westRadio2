# Painel: somente diretivas permitidas em .htaccess.
# ModSecurity e os limites PHP sao gerenciados pela hospedagem e pelo .user.ini.
Options -Indexes -MultiViews
AddDefaultCharset UTF-8

# URLs inexistentes do painel nao devem cair na home publica.
<IfModule mod_dir.c>
    FallbackResource disabled
</IfModule>
