<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloqueia acesso HTTP aos arquivos internos, sem afetar includes do PHP.
    RewriteRule ^(?:config|includes|admin/includes|scratch|\.git|\.agents|\.codex|\.aws)(?:/|$) - [F,L,NC]

    # Evita listagem de diretórios e conflitos de MultiViews (que causam erro 404 e 406)
    Options -Indexes -MultiViews
</IfModule>

# ModSecurity e gerenciado pela hospedagem; nao desativar via .htaccess.

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>

    # Forçar HTTPS (HostGator AutoSSL)
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redireciona tudo que não for arquivo ou diretório válido
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Regras de roteamento para URLs amigáveis
    RewriteRule ^noticia/([a-zA-Z0-9_-]+)/?$ noticia.php?slug=$1 [L,QSA]
    RewriteRule ^categoria/([a-zA-Z0-9_-]+)/?$ categoria.php?slug=$1 [L,QSA]
    RewriteRule ^busca/?$ busca.php [L,QSA]

    # Páginas simples
    RewriteRule ^ao-vivo/?$ aovivo.php [L]
    RewriteRule ^sobre/?$ sobre.php [L]
    RewriteRule ^contato/?$ contato.php [L]
    RewriteRule ^login/?$ login.php [L]
    RewriteRule ^cadastro/?$ cadastro.php [L]
    RewriteRule ^perfil/?$ perfil.php [L]
    RewriteRule ^migrar-banco/?$ migrar-banco.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Fallback de contingência
    <IfModule mod_dir.c>
        FallbackResource /index.php
    </IfModule>
</IfModule>

# Otimização de Performance: Compressão GZIP / Brotli
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript image/svg+xml
</IfModule>

# Otimização de Performance: Cache de Navegador (Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Proteção de Arquivos Sensíveis
<FilesMatch "\.(sql|ini|env|md|log|sqlite)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acesso aos diretórios internos
# DirectoryMatch nao e permitido em .htaccess. O bloqueio fica nas regras acima.
